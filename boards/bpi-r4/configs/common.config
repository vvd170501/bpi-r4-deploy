CONFIG_TARGET_ROOTFS_SQUASHFS=y

# MediaTek packages are built locally; OpenWrt hosts no download repository.
# CONFIG_FEED_mtk_openwrt_feed is not set

CONFIG_DROPBEAR_ECDSA=y
CONFIG_DROPBEAR_ECC_256=y

CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_mdio-tools=y
