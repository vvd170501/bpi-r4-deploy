CONFIG_DEVEL=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# NVMe p2 capacity in MiB (also used for the SD/eMMC image partition).
CONFIG_TARGET_ROOTFS_PARTSIZE=8192
# NVMe p3 writable overlay capacity in MiB (fresh installations only).
CONFIG_BPI_R4_NVME_OVERLAY_PARTSIZE=8192

CONFIG_CRYPTO_MTK_DDK_LOOKASIDE=y


CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y
CONFIG_KERNEL_CGROUP_DEVICE=y
