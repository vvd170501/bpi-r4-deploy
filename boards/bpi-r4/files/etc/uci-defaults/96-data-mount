#!/bin/sh
# Bind /data to p4 on the same SSD as the SquashFS lower, not an arbitrary disk
# sharing a filesystem label. Do nothing in the temporary SD system.
. /lib/functions/nvme-squashfs.sh
nvme_squashfs_booted || exit 0
nvme_squashfs_parts || exit 1
uuid=$(blkid -s UUID -o value "${NVME_DISK}p4")
[ -n "$uuid" ] || exit 1
uci set fstab.nvme_data=mount
uci set fstab.nvme_data.target='/data'
uci set fstab.nvme_data.uuid="$uuid"
uci set fstab.nvme_data.enabled='1'
uci set fstab.nvme_data.options='rw,noatime'
uci commit fstab
mkdir -p /data
