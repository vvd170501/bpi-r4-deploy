@@ -79,6 +80,37 @@
 		)
 	cat $@.tmp >> $@
 	rm $@.tmp
+endef
+
+# NVMe uses a kernel/DT-only FIT and a separate ZSTD SquashFS image. Build
+# from the same per-device tree as the XZ SD/eMMC root, without changing it.
+# Use the standard sysupgrade tar; partition capacities live in its metadata.
+define Build/bpi-r4-nvme-sysupgrade
+	cp $@ $@.kernel
+	test $$(stat -c%s $@.kernel) -le 268435456
+	case "$(CONFIG_BPI_R4_NVME_OVERLAY_PARTSIZE)" in ''|0*|*[!0-9]*) exit 1 ;; esac
+	test "$(CONFIG_BPI_R4_NVME_OVERLAY_PARTSIZE)" -gt 0
+	$(STAGING_DIR_HOST)/bin/mksquashfs4 \
+		$(call mkfs_target_dir,$(if $(TARGET_PER_DEVICE_ROOTFS),pkg=$(ROOTFS_ID/$(DEVICE_NAME)))) \
+		$@.root -nopad -noappend -root-owned -comp zstd -Xcompression-level 9 $(SQUASHFSOPT)
+	test $$(stat -c%s $@.root) -le $$(($(CONFIG_TARGET_ROOTFS_PARTSIZE) * 1048576))
+	$(call Build/sysupgrade-tar,kernel=$@.kernel rootfs=$@.root)
+	rm $@.kernel $@.root
+endef
+
+# Scope these fields to the NVMe artifact while reusing upstream metadata/signing.
+# foreach's list has no whitespace, so IMAGE_METADATA is one local binding.
+define Build/bpi-r4-nvme-metadata
+	$(foreach IMAGE_METADATA,"nvme_layout":"bpi-r4-nvme-squashfs-v1"$(comma)"nvme_rootfs_partsize":"$(CONFIG_TARGET_ROOTFS_PARTSIZE)"$(comma)"nvme_overlay_partsize":"$(CONFIG_BPI_R4_NVME_OVERLAY_PARTSIZE)",$(call Build/append-metadata))
+endef
+
+# Boot firmware only: production packages/rootfs never go into NAND.
+define Build/bpi-r4-nand-firmware
+	sh $(TOPDIR)/scripts/ubinize-image.sh --uboot-env \
+		$(foreach part,$(UBINIZE_PARTS),--part $(part)) $@.ubi \
+		-p $(BLOCKSIZE:%k=%KiB) -m $(PAGESIZE) $(UBINIZE_OPTS)
+	cat $@.ubi >> $@
+	rm $@.ubi
 endef
 
