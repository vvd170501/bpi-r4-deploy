+config BPI_R4_NVME_OVERLAY_PARTSIZE
+	int "BPI-R4 NVMe overlay partition size (in MiB)"
+	depends on TARGET_mediatek_filogic
+	range 1 2147483647
+	default 16384
+	help
+	  Capacity of the ext4 rootfs_data partition on fresh NVMe installs.
+	  Sysupgrade preserves the existing partition size.
+
