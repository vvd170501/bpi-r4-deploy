@@ -44,6 +51,12 @@
 }
 
 fit_do_upgrade() {
+	if nvme_squashfs_booted; then
+		# Dispatch before bootloader discovery so NAND is never upgraded.
+		# do_stage2 otherwise continues to reboot even on a returned error.
+		nvme_do_upgrade "$1" || exit 1
+		return
+	fi
 	export_fitblk_bootdev
 	[ -n "$CI_METHOD" ] || return 1
 	[ -e /dev/fit0 ] && fitblk /dev/fit0
